@base <https://bhni23vb.github.io/LOIN-DDD/ddf> . 

<https://bhni23vb.github.io/LOIN-DDD/ddf> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://bhni23vb.github.io/LOIN-DDD/ddf/v1.1> ;
                                            rdfs:comment "This is the Data Dictionary created for Lighting Fixture based on SIS-CEN/TS 17623:2021 by resusing existing ontologies such as Lighting Fixture Product Ontology (LPPO), LOIN, Isoprops, Data Template Ontology (TempO) to address the use case in a master's thesis by Mohamad Monir Taktak & Nischal Bhattarai.The thesis project Lifting Heterogeneous Data into RDF/OWL Knowledge Graph: A Semantic Approach conducted as part of the Master's program in Sustainable Building Information Management at Jönköping University.";
                                            dcterms:title "Data Dictionary for Lighting Fixture" ;
                                            dcterms:creator "Nischal Bhattarai";
                                            dcterms:description "A DD";
                                            dcterms:issued "2025-10-12"^^xsd:date.



### Photometric data type properties
ddf:CorrelatedColorTemperature a isoprops:Property ;
    skos:definition "The colour temperature of any source of radiation is defined as the temperature (in Kelvin) of a black-body or Planckian radiator whose radiation has the same chromaticity as the source radiation. See Also EN12665." ;
    dcterms:identifier "04-0023" ;
    rdfs:label "Correlated Color Temperature (CCT)" ;
    skos:notation "Tb" ;
    tempo:hasDatatype ddf:CCTDatatype ; 
    isoprops:hasUnit unit:K ; 
    isoprops:globallyUniqueIdentifier  "0XeHsouWz8PxASJ4mpkdEY" .

ddf:LumenOutput a isoprops:Property ;
    skos:definition "Value of the initial luminous flux of a given type of light source declared by the manufacturer or the responsible vendor, the light source being operated at an ambient temperature of 25 degree celcius. See also EN13032-4." ;
    dcterms:identifier "04-0006" ;
    rdfs:label "Rated Luminous flux of the light source" ;
    tempo:hasDatatype ddf:LumenOutputDatatype ; 
    isoprops:hasUnit unit:LM ; 
    isoprops:globallyUniqueIdentifier  "2gmo70bVX90uJh2YAvS62s" .

ddf:LuminousEfficacy a isoprops:Property ;
    skos:definition "Quotient of the luminous flux emitted by the luminaire and the power absorbed by the light source and associated circuits of the luminaire." ;
    dcterms:identifier "04-0007" ;
    rdfs:label "Luminous Efficacy" ;
    tempo:hasDatatype ddf:LuminousEfficacyDatatype ; 
    isoprops:hasUnit unit:LM-Per-W ; 
    isoprops:globallyUniqueIdentifier "1QmFILGbX6_BfU63rG5mrh" .

#Datatype expansion
ddf:CCTDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:LumenOutputDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:LuminousEfficacyDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

### Electrical data type properties
ddf:RatedVoltage a isoprops:Property ;
    skos:definition "Nominal voltage at which the product operates normally as specified by the supplier or manufacturer." ;
    dcterms:identifier "02-0028" ;
    rdfs:label "Nominal mains volatage" ;
    tempo:hasDatatype ddf:RatedVoltageDatatype ; 
    isoprops:hasUnit unit:V ; 
    isoprops:globallyUniqueIdentifier  "3ERn8VgnjDjhulH3MaG9yG" .

ddf:PowerFactor  a isoprops:Property ;
    skos:definition "Ratio of the amount of the active power to the apparant power at 100% load. See Also IEC 80000-6." ;
    dcterms:identifier "02-0003" ;
    rdfs:label "Power Factor" ;
    skos:notation "cos φ " ;
    tempo:hasDatatype ddf:PowerFactorDatatype ; 
    isoprops:hasUnit unit:UNITLESS ; 
    isoprops:globallyUniqueIdentifier  "3LBrQkLDDFheBOxrGk8Zr_" .

ddf:StandByPower a isoprops:Property ;
    skos:definition "Power consumption of switched off luminaire. All electrical components including emergency and lighting controls components have to be considered. Is also known as parasitic power. See also EN 15193-1." ;
    dcterms:identifier "02-0006" ;
    rdfs:label "Standby Power" ;
    tempo:hasDatatype ddf:StandByPowerDatatype ; 
    isoprops:hasUnit unit:W ; 
    isoprops:globallyUniqueIdentifier  "0TzE4sMDv1pwfygK1xxjm5" .

#Datatype expansion
ddf:RatedVoltageDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:PowerFactorDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:StandByPowerDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

### MechanicalInstallation data type properties
ddf:Length a isoprops:Property ;
    skos:definition "Length of the housing of the luminaire or sensing device. Length is set parallel to the C90-C270 plane. Corresponds to y-axis and with 90 horizontal of the Light Distribution Curve. This definition is regardless of orientation of luminaires. See Figure 1." ;
    dcterms:identifier "01-0003" ;
    rdfs:label "Length" ;
    tempo:hasDatatype ddf:LengthDatatype ; 
    isoprops:hasUnit unit:MilliM ; 
    isoprops:globallyUniqueIdentifier  "1uJglYpRnFpQ4tStHaR2Pf" .

ddf:Width  a isoprops:Property ;
    skos:definition "Width of the housing of the luminaire or sensing device. Width is set parallel to the C0-C180 plane. Corresponds to the x-axis and with 0 horizontal of the Light Distribution Curve. This definition is regardless of orientation of luminaires. See Figure 1." ;
    dcterms:identifier "01-0004" ;
    rdfs:label "Width" ;
    tempo:hasDatatype ddf:WidthDatatype; 
    isoprops:hasUnit unit:MilliM ; 
    isoprops:globallyUniqueIdentifier  "1dPvrZN3vEIB0n0vwYvDcX" .

ddf:Height a isoprops:Property ;
    skos:definition "Height of the housing of the luminaire or sensing device. Corresponds to z-axis, gaMilliM angle 180 and 180 vertical of the light distribution curve. This definition is regardless or orientation of luminaires. See Figures 1." ;
    dcterms:identifier "01-0002" ;
    rdfs:label "Height" ;
    tempo:hasDatatype ddf:HeightDatatype ; 
    isoprops:hasUnit unit:MilliM ; 
    isoprops:globallyUniqueIdentifier  "19Z9XKYDT4p8HR0ZbD$wO_" .

ddf:IPRating  a isoprops:Property ;
    skos:definition "The IP code classifies and rates the degree of protection provided against intrusion (body parts such as hands and fingers), dust, accidental contact, and water by mechanical casing and electrical enclosures. See Also, EN 60529." ;
    dcterms:identifier "02-0031" ;
    rdfs:label "Ingress protection IP Code" ;
    tempo:hasDatatype ddf:IPRatingDatatype ; 
    isoprops:hasUnit unit:UNITLESS ; 
    isoprops:globallyUniqueIdentifier  "1K_1K1q6n7KgOFJw5Cuc_i" .
    

ddf:MountingType a isoprops:Property ;
    skos:definition "Type of mounting used for the luminaire or sensing device." ;
    dcterms:identifier "06-0003" ;
    rdfs:label "Mounting Type" ;
    tempo:hasDatatype ddf:MountingTypeDatatype ; 
    isoprops:hasUnit unit:UNITLESS ; 
    isoprops:globallyUniqueIdentifier  "3m5UX0NuH4YRPUJ1EmzXz7" .

#Datatype expansion
ddf:LengthDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:WidthDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:HeightDatatype a tempo:Datatype ;
  tempo:dataType xsd:float .

ddf:IPRatingDatatype a tempo:Datatype ;
    tempo:dataType xsd:string ;
    tempo:hasEnumeration    ddf:IPEnumeration .

ddf:MountingTypeDatatype a tempo:Datatype ;
    tempo:dataType xsd:string ;
    tempo:hasEnumeration    ddf:MountingTypeEnumeration .

