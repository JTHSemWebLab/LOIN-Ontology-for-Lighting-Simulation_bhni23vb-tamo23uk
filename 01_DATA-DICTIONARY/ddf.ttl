#Enumeration List for Mounting Type.
ddf:MountingTypeEnumeration a tempo:Enumeration    ;
    tempo:hasEnumerationItem  
    ddf:SurfaceMounted ,
    ddf:Pendant ,
    ddf:FreeStanding ,
    ddf:Recessed ,
    ddf:PartlyRecessed ,
    ddf:TrimlessRecessed ,
    ddf:PoleTop ,
    ddf:PoleSideEntry ,
    ddf:PoleIntegrated ,
    ddf:ConductorRail ,
    ddf:Connector . 

# Enumeration item for Mounting Type
ddf:SurfaceMounted   a tempo:EnumerationItem ; rdfs:label "Surface mounted"@en ;  schema:value "surface-mounted" ;   tempo:order "1" .
ddf:Pendant          a tempo:EnumerationItem ; rdfs:label "Pendant"@en ;          schema:value "pendant" ;          tempo:order "2" .
ddf:FreeStanding     a tempo:EnumerationItem ; rdfs:label "Free standing"@en ;    schema:value "free-standing" ;    tempo:order "3" .
ddf:Recessed         a tempo:EnumerationItem ; rdfs:label "Recessed"@en ;         schema:value "recessed" ;         tempo:order "4" .
ddf:PartlyRecessed   a tempo:EnumerationItem ; rdfs:label "Partly recessed"@en ;  schema:value "partly-recessed" ;  tempo:order "5" .
ddf:TrimlessRecessed a tempo:EnumerationItem ; rdfs:label "Trimless recessed"@en ;schema:value "trimless-recessed" ; tempo:order "6" .
ddf:PoleTop          a tempo:EnumerationItem ; rdfs:label "Pole-top"@en ;         schema:value "pole-top" ;         tempo:order "7" .
ddf:PoleSideEntry    a tempo:EnumerationItem ; rdfs:label "Pole-side entry"@en ;  schema:value "pole-side-entry" ;  tempo:order "8" .
ddf:PoleIntegrated   a tempo:EnumerationItem ; rdfs:label "Pole-integrated"@en ;  schema:value "pole-integrated" ;  tempo:order "9" .
ddf:ConductorRail    a tempo:EnumerationItem ; rdfs:label "Conductor rail"@en ;   schema:value "conductor-rail" ;   tempo:order "10" .
ddf:Connector        a tempo:EnumerationItem ; rdfs:label "Connector"@en ;        schema:value "connector" ;        tempo:order "11" .
ddf:Other            a tempo:EnumerationItem ; rdfs:label "Other"@en ;            schema:value "other" ;            tempo:order "12" .
